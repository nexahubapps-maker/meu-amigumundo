{
  "name": "amigumundo",
  "compatibility_date": "2026-08-31",
  "main": "./worker/index.ts",
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    }
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/receita/*",
      "/pack/*",
      "/infoproduto/*",
      "/categoria/*",
      "/premium",
      "/entrar-grupo",
      "/capa/*",
      "/premium-pdf/*",
      "/.netlify/functions/*",
      "/webhook-mercadopago",
      "/debug-mp"
    ]
  }
}
