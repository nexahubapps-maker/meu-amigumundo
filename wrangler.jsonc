{
  "name": "amigumundo",
  "compatibility_date": "2026-08-31",
  "main": "./worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/receita/*",
      "/pack/*",
      "/infoproduto/*",
      "/categoria/*",
      "/premium",
      "/entrar-grupo",
      "/capa/*",
      "/.netlify/functions/*",
      "/webhook-mercadopago"
    ]
  }
}
